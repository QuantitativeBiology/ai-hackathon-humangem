{
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "fallbackModel": [
    "claude-sonnet-5-5"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|NotebookRead|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_labels.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
