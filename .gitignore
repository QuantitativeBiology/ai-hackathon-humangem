# Data (large; not versioned) - only the provenance README is tracked
data/*
!data/README.md
!data/checksums.tsv

# Analysis outputs are committed (PROMPT.md); only bulky intermediates are ignored
results/**/tmp/
results/**/*.large.*

# Python environment
.venv/
*.egg-info/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Claude Code local (personal) settings
.claude/settings.local.json

# OS / editor
.DS_Store
*.swp

# Papers (copyrighted; never committed)
papers/
